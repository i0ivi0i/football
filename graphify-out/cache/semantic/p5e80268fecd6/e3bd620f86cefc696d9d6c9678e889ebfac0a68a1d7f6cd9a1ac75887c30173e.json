{"nodes": [{"id": "p2003_09384_modified_pi_rating_system", "label": "Modified Pi-Rating System", "file_type": "concept", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2003.09384_Asian_Handicap_Market_Efficiency_Bayesian_Networks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Removes the Psi(e) goal-diminishing function to optimize directly for expected goal difference needed in Asian Handicap betting, and introduces parameter k=3 for teams with under 38 matches to speed up rating convergence."}, {"id": "p2003_09384_hybrid_bayesian_network", "label": "Beta-Binomial Hybrid Bayesian Network", "file_type": "concept", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2003.09384_Asian_Handicap_Market_Efficiency_Bayesian_Networks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses domain-knowledge temporal causal graph structure (Possession -> Shots -> Shots on Target -> Goals) because purely data-driven structure learning algorithms struggle with noisy real-world sports data."}, {"id": "p2003_09384_asian_handicap_market", "label": "Asian Handicap Market Mechanics", "file_type": "concept", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2003.09384_Asian_Handicap_Market_Efficiency_Bayesian_Networks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "p2003_09384_market_efficiency_comparison", "label": "Asian Handicap vs 1X2 Market Efficiency", "file_type": "concept", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2003.09384_Asian_Handicap_Market_Efficiency_Bayesian_Networks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "p2003_09384_roi_vs_profit_optimization", "label": "ROI vs Profit Optimisation Strategy", "file_type": "concept", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2003.09384_Asian_Handicap_Market_Efficiency_Bayesian_Networks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-season ROI optimisation leads to inconsistent long-term results due to decision threshold instability, whereas per-season profit maximisation guarantees overall multi-season profit maximisation and higher long-term ROI."}], "edges": [{"source": "p2003_09384_hybrid_bayesian_network", "target": "p2003_09384_modified_pi_rating_system", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2003.09384_Asian_Handicap_Market_Efficiency_Bayesian_Networks.md", "source_location": null, "weight": 1.0}, {"source": "p2003_09384_market_efficiency_comparison", "target": "p2003_09384_hybrid_bayesian_network", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2003.09384_Asian_Handicap_Market_Efficiency_Bayesian_Networks.md", "source_location": null, "weight": 1.0}, {"source": "p2003_09384_market_efficiency_comparison", "target": "p2003_09384_asian_handicap_market", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2003.09384_Asian_Handicap_Market_Efficiency_Bayesian_Networks.md", "source_location": null, "weight": 1.0}, {"source": "p2003_09384_roi_vs_profit_optimization", "target": "p2003_09384_market_efficiency_comparison", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2003.09384_Asian_Handicap_Market_Efficiency_Bayesian_Networks.md", "source_location": null, "weight": 1.0},