{"nodes": [{"id": "wenguerzhixinxuexiziliao_2025_success_score_deep_learning_football_prediction_success_score_metric", "label": "Success Score Metric", "file_type": "concept", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2025_Success_Score_Deep_Learning_Football_Prediction.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Farzam Manafzadeh, Changiz Eslahchi, Hadi Nobari", "contributor": null, "rationale": "Blends Expected Goals (xG) with actual goals through base adjustment beta=0.5, sigmoid transformation, and zero-sum team normalization out of 10."}, {"id": "wenguerzhixinxuexiziliao_2025_success_score_deep_learning_football_prediction_tactical_play_styles", "label": "Ten Tactical Play Styles Framework", "file_type": "concept", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2025_Success_Score_Deep_Learning_Football_Prediction.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Farzam Manafzadeh, Changiz Eslahchi, Hadi Nobari", "contributor": null, "rationale": "Aggregates specific FBref match metrics into quantifiable indicators representing 10 primary tactical paradigms."}, {"id": "wenguerzhixinxuexiziliao_2025_success_score_deep_learning_football_prediction_dnn_framework", "label": "Success Score DNN Architecture", "file_type": "concept", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2025_Success_Score_Deep_Learning_Football_Prediction.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Farzam Manafzadeh, Changiz Eslahchi, Hadi Nobari", "contributor": null, "rationale": "Utilizes Deep Neural Networks with rolling short-term and long-term averages plus SoFIFA attributes to forecast pre-match Success Scores."}, {"id": "2025_success_score_deep_learning_football_prediction_dnn_model", "label": "Deep Neural Network Model", "file_type": "concept", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2025_Success_Score_Deep_Learning_Football_Prediction.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Employed four fully connected layers (256, 128, 64, 1) with Tanh activations and Dropout (0.2) regularization to predict the home team's Success Score on a 0-10 scale."}, {"id": "2025_success_score_deep_learning_football_prediction_feature_vector_68d", "label": "68-Dimensional Input Vector", "file_type": "concept", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2025_Success_Score_Deep_Learning_Football_Prediction.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2025_success_score_deep_learning_football_prediction_rolling_averages", "label": "Rolling Averages Feature Engineering", "file_type": "concept", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2025_Success_Score_Deep_Learning_Football_Prediction.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reduces short-term variability and captures dynamic performance trends across phases of the season."}, {"id": "2025_success_score_deep_learning_football_prediction_success_score_metric", "label": "Success Score Metric", "file_type": "concept", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2025_Success_Score_Deep_Learning_Football_Prediction.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Blends goals scored with Expected Goals (xG) to provide a holistic, objective evaluation of team effectiveness."}, {"id": "2025_success_score_deep_learning_football_prediction_threshold_classification", "label": "Match Outcome Classification Thresholds", "file_type": "concept", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2025_Success_Score_Deep_Learning_Football_Prediction.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Candidate cut-points swept and selected as tau_low = 4.6 and tau_high = 5.3 to maximize out-of-fold macro-accuracy for Lose/Draw/Win mapping."}, {"id": "2025_success_score_deep_learning_football_prediction_home_advantage_analysis", "label": "Home Ground Advantage Statistical Analysis", "file_type": "concept", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2025_Success_Score_Deep_Learning_Football_Prediction.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}], "edges": [{"source": "wenguerzhixinxuexiziliao_2025_success_score_deep_learning_football_prediction_dnn_framework", "target": "wenguerzhixinxuexiziliao_2025_success_score_deep_learning_football_prediction_success_score_metric", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2025_Success_Score_Deep_Learning_Football_Prediction.md", "source_location": null, "weight": 1.0}, {"source": "wenguerzhixinxuexiziliao_2025_success_score_deep_learning_football_prediction_dnn_framework", "target": "wenguerzhixinxuexiziliao_2025_success_score_deep_learning_football_prediction_tactical_play_styles", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2025_Success_Score_Deep_Learning_Football_Prediction.md", "source_location": null, "weight": 1.0}, {"source": "2025_success_score_deep_learning_football_prediction_feature_vector_68d", "target": "2025_success_score_deep_learning_football_prediction_rolling_averages", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/202