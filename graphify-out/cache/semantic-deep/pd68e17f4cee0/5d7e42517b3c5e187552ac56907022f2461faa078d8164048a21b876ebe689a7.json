{"nodes": [{"id": "doc_combining_historical_data_odds", "label": "Combining Historical Data and Bookmakers' Odds (Egidi et al.)", "file_type": "paper", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/1802.08848_Combining_Historical_Data_and_Bookmakers_Odds.md", "source_location": null, "source_url": "https://arxiv.org/abs/1802.08848", "captured_at": null, "author": "Leonardo Egidi, Francesco Pauli, Nicola Torelli", "contributor": null, "rationale": "Develops a hierarchical Bayesian Poisson model blending historical goal parameters with implicit bookmaker scoring intensities."}, {"id": "180208848_combining_historical_data_and_bookmakers_odds_egidi_model", "label": "Hierarchical Bayesian Poisson Model (Egidi et al.)", "file_type": "paper", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/1802.08848_Combining_Historical_Data_and_Bookmakers_Odds.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Leonardo Egidi et al.", "contributor": null, "rationale": "Combines historical match scores and implicit scoring rates from bookmakers' odds via a convex combination to enrich football prediction."}, {"id": "180208848_combining_historical_data_and_bookmakers_odds_skellam_distribution", "label": "Skellam Distribution Formulation", "file_type": "concept", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/1802.08848_Combining_Historical_Data_and_Bookmakers_Odds.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Under Poisson conditional independence of match scores, goal difference follows a Skellam (Poisson-Difference) distribution, enabling extraction of implicit scoring intensities from odds."}, {"id": "180208848_combining_historical_data_and_bookmakers_odds_shin_method", "label": "Shin's Normalisation Method", "file_type": "concept", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/1802.08848_Combining_Historical_Data_and_Bookmakers_Odds.md", "source_location": null, "source_url": null, "captured_at": null, "author": "H. S. Shin", "contributor": null, "rationale": "Accounts for insider trading rates in betting markets to extract true underlying outcome probabilities from bookmaker odds."}, {"id": "180208848_combining_historical_data_and_bookmakers_odds_team_effects", "label": "Dynamic Seasonal Team Effects", "file_type": "concept", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/1802.08848_Combining_Historical_Data_and_Bookmakers_Odds.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Attack and defence strengths are assumed dynamic across seasons following a Normal distribution centred at previous season effects plus fixed drift, avoiding static limitations."}], "edges": [{"source": "doc_combining_historical_data_odds", "target": "concept_shin_inversion_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/1802.08848_Combining_Historical_Data_and_Bookmakers_Odds.md", "source_location": null, "weight": 1.0}, {"source": "doc_combining_historical_data_odds", "target": "concept_ranked_probability_score", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/1802.08848_Combining_Historical_Data_and_Bookmakers_Odds.md", "source_location": null, "weight": 1.0}, {"source": "180208848_combining_historical_data_and_bookmakers_odds_egidi_model", "target": "180208848_combining_historical_data_and_bookmakers_odds_skellam_distribution", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/1802.08848_Combining_Historical_Data_and_Bookmakers_Odds.md", "source_location": null, "weight": 1.0},