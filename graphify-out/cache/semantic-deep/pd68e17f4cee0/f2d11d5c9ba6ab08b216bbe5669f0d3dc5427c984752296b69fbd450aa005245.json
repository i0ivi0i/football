{"nodes": [{"id": "2604_17194_forecast_sports_outcomes_under_emh_odds_only_models_oo_epc", "label": "Odds-Only-Equal-Profitability-Confidence (OO-EPC) Method", "file_type": "concept", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2604.17194_Forecast_Sports_Outcomes_under_EMH_Odds_Only_Models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reduces inverse odds by a constant multiple of standard errors (z*sigma) to reflect the bookmaker objective of having equal confidence in profitability without needing historical data."}, {"id": "2604_17194_forecast_sports_outcomes_under_emh_odds_only_models_fl_glm", "label": "Favourite-Longshot-Bias-Adjusted GLM (FL-GLM)", "file_type": "concept", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2604.17194_Forecast_Sports_Outcomes_under_EMH_Odds_Only_Models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fits a single power parameter beta to inverse odds with an adaptive normalization intercept, providing an interpretable quantification of favourite-longshot bias."}, {"id": "2604_17194_forecast_sports_outcomes_under_emh_odds_only_models_favourite_longshot_bias", "label": "Favourite-Longshot Bias", "file_type": "concept", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2604.17194_Forecast_Sports_Outcomes_under_EMH_Odds_Only_Models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2604_17194_forecast_sports_outcomes_under_emh_odds_only_models_emh", "label": "Efficient Market Hypothesis in Sports Betting (EMH)", "file_type": "concept", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2604.17194_Forecast_Sports_Outcomes_under_EMH_Odds_Only_Models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2604_17194_forecast_sports_outcomes_under_emh_odds_only_models_oo_epc_method", "label": "OO-EPC Method", "file_type": "concept", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2604.17194_Forecast_Sports_Outcomes_under_EMH_Odds_Only_Models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Theoretically-driven to ensure each outcome provides the same confidence in profitability for the bookmaker without needing historical odds."}, {"id": "2604_17194_forecast_sports_outcomes_under_emh_odds_only_models_fl_glm_model", "label": "FL-GLM (Favourite-Longshot Bias Adjusted GLM)", "file_type": "concept", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2604.17194_Forecast_Sports_Outcomes_under_EMH_Odds_Only_Models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Data-driven model to adjust for the favourite-longshot bias measured from historical betting odds."}, {"id": "2604_17194_forecast_sports_outcomes_under_emh_odds_only_models_proposition_7", "label": "Proposition 7 (Log-Loss and Profitability)", "file_type": "paper", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2604.17194_Forecast_Sports_Outcomes_under_EMH_Odds_Only_Models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Proves log-loss captures bookmakers' profitability because difference in log-loss directly derives the payout ratio u = exp(-v)."}, {"id": "2604_17194_forecast_sports_outcomes_under_emh_odds_only_models_property_5", "label": "Property 5", "file_type": "paper", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2604.17194_Forecast_Sports_Outcomes_under_EMH_Odds_Only_Models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Proves multiplicative conversion is equivalent to FL-GLM when power constant beta is assumed to be 1."}, {"id": "2604_17194_forecast_sports_outcomes_under_emh_odds_only_models_property_6", "label": "Property 6", "file_type": "paper", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2604.17194_Forecast_Sports_Outcomes_under_EMH_Odds_Only_Models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Proves power conversion is equivalent to FL-GLM when the normalisation term is assumed to be 1."}, {"id": "2604_17194_forecast_sports_outcomes_under_emh_odds_only_models_draw_bias", "label": "Draw Bias Phenomenon", "file_type": "concept", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2604.17194_Forecast_Sports_Outcomes_under_EMH_Odds_Only_Models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Draw outcomes have a weaker favourite-longshot bias than decisive outcomes, causing uniform bias-adjustment methods to underestimate draw probabilities."}, {"id": "2604_17194_forecast_sports_outcomes_under_emh_odds_only_models_two_power_constants_extension", "label": "Two Power Constants FL-GLM Extension", "file_type": "concept", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2604.17194_Forecast_Sports_Outcomes_under_EMH_Odds_Only_Models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Introduces separate beta_decisive and beta_draw parameters fitted via maximum likelihood to alleviate draw bias under weaker favourite-longshot bias in draws."}, {"id": "2604_17194_forecast_sports_outcomes_under_emh_odds_only_models_goto_conversion", "label": "Goto Conversion Repository", "file_type": "code", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2604.17194_Forecast_Sports_Outcomes_under_EMH_Odds_Only_Models.md", "source_location": null, "source_url": "https://github.com/gotoConversion/goto_conversion", "captured_at": null, "author": "Goto K", "contributor": null, "rationale": "Open-source implementation of OO-EPC used widely across competitive forecasting solutions."}], "edges": [{"source": "2604_17194_forecast_sports_outcomes_under_emh_odds_only_models_oo_epc", "target": "2604_17194_forecast_sports_outcomes_under_emh_odds_only_models_emh", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2604.17194_Forecast_Sports_Outcomes_under_EMH_Odds_Only_Models.md", "source_location": null, "weight": 1.0}, {"source": "2604_17194_forecast_sports_outcomes_under_emh_odds_only_models_fl_glm", "target": "2604_17194_forecast_sports_outcomes_under_emh_odds_only_models_favourite_longshot_bias", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2604.17194_Forecast_Sports_Outcomes_under_EMH_Odds_Only_Models.md", "source_location": null, "weight": 1.0}, {"source": "2604_17194_forecast_sports_outcomes_under_emh_odds_only_models_property_5", "target": "2604_17194_forecast_sports_outcomes_under_emh_odds_only_models_fl_glm_model", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2604.17194_Forecast_Sports_Outcomes_under_EMH_Odds_Only_Models.md", "source_location": null, "weight": 1.0}, {"source": "2604_17194_forecast_sports_outcomes_under_emh_odds_only_models_property_6", "target": "2604_17194_forecast_sports_outcomes_under_emh_odds_only_models_fl_glm_model", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\