ng real funds without execution risk."}, {"id": "1710_02824_bookmaker_restrictions", "label": "Bookmaker Account Limiting / Discriminatory Practices", "file_type": "concept", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/1710.02824_Beating_the_Bookies_with_Their_Own_Numbers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compensates for market inefficiency by restricting stakes or banning successful bettors, forcing experiment termination."}], "edges": [{"source": "1710_02824_betting_strategy", "target": "1710_02824_consensus_probability", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/1710.02824_Beating_the_Bookies_with_Their_Own_Numbers.md", "source_location": null, "weight": 1.0}, {"source": "1710_02824_betting_strategy", "target": "1710_02824_paper_trading", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/1710.02824_Beating_the_Bookies_with_Their_Own_Numbers.md", "source_location": null, "weight": 1.0}, {"source": "1710_02824_betting_strategy", "target": "1710_02824_bookmaker_restrictions", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/1710.02824_Beating_the_Bookies_with_Their_Own_Numbers.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "odds_wisdom_of_crowds_paradigm", "label": "Betting Market Aggregate Information Framework", "nodes": ["1710_02824_consensus_probability", "2018_plos_elo_odds", "2008_sentiment_sentiment_bias"], "relation": "form", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/1710.02824_Beating_the_Bookies_with_Their_Own_Number