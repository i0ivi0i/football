{"nodes": [{"id": "2025_springer_predicting_draws_and_fouls_bayesian_md", "label": "Predicting Draws and Number of Fouls in Football Matches using Bayesian Network Classifiers", "file_type": "paper", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2025_Springer_Predicting_Draws_and_Fouls_Bayesian.md", "source_location": null, "source_url": "https://doi.org/10.1007/s13748-025-00395-8", "captured_at": null, "author": "Nicol\u00e1s P\u00e9rez-Blanco; Antonio Salmer\u00f3n", "contributor": null, "rationale": null}, {"id": "2025_springer_nb_fouls_model", "label": "Naive Bayes Foul Prediction Model", "file_type": "concept", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2025_Springer_Predicting_Draws_and_Fouls_Bayesian.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses 5 foul-intervals of 4 teams each and distance-based membership weighting to handle ordinal foul distribution."}, {"id": "2025_springer_nb_draw_model", "label": "Naive Bayes Draw Prediction Model", "file_type": "concept", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2025_Springer_Predicting_Draws_and_Fouls_Bayesian.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Maximizes inter-class separation between draws and non-draws via clustering guided by a secondary NB quality classifier."}, {"id": "2025_springer_rps_metric", "label": "Rank Probability Score (RPS)", "file_type": "concept", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2025_Springer_Predicting_Draws_and_Fouls_Bayesian.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recommended for ordinal-class evaluation because it penalizes misclassifications across distant categories more severely than adjacent ones."}, {"id": "2025_springer_wap_war_metrics", "label": "Weighted Accuracy & Recall (WAP / WAR)", "file_type": "concept", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2025_Springer_Predicting_Draws_and_Fouls_Bayesian.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Weights instances inversely proportional to class prevalence to evaluate performance on highly imbalanced football draw outcomes."}, {"id": "2025_springer_distance_discretization", "label": "Relative-Distance Cluster Discretization", "file_type": "concept", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2025_Springer_Predicting_Draws_and_Fouls_Bayesian.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces within-cluster homogeneity optimization with boundary distance weights to maintain class separability in NB classifiers."}], "edges": [{"source": "2025_springer_predicting_draws_and_fouls_bayesian_md", "target": "2025_springer_nb_fouls_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2025_Springer_Predicting_Draws_and_Fouls_Bayesian.md", "source_location": null, "weight": 1.0}, {"source": "2025_springer_predicting_draws_and_fouls_bayesian_md", "target": "2025_springer_nb_draw_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2025_Springer_Predicting_Draws_and_Fouls_Bayesian.md", "source_location": null, "weight": 1.0}, {"source": "2025_springer_nb_fouls_model", "target": "2025_springer_rps_metric", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2025_Springer_Predicting_Draws_and_Fouls_Bayesian.md", "source_location": null, "weight": 1.0