{"nodes": [{"id": "2604_17194_forecast_sports_outcomes_under_emh_odds_only_models_md", "label": "Forecast Sports Outcomes under EMH: Odds-Only and GLMs", "file_type": "paper", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2604.17194_Forecast_Sports_Outcomes_under_EMH_Odds_Only_Models.md", "source_location": null, "source_url": "https://doi.org/10.1177/ToBeAssigned", "captured_at": null, "author": "Kaito Goto; Naoya Takeishi; Takehisa Yairi", "contributor": null, "rationale": null}, {"id": "2604_17194_oo_epc_method", "label": "Odds-Only-Equal-Profitability-Confidence (OO-EPC)", "file_type": "concept", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2604.17194_Forecast_Sports_Outcomes_under_EMH_Odds_Only_Models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decreases all inverse odds by uniform standard errors z*sigma to match the bookmaker's objective of equal profitability confidence without historical training data."}, {"id": "2604_17194_multiplicative_conversion", "label": "Multiplicative Odds Conversion", "file_type": "concept", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2604.17194_Forecast_Sports_Outcomes_under_EMH_Odds_Only_Models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Normalises inverse odds under the naive assumption that expected loss is identical across all outcomes."}, {"id": "2604_17194_shin_conversion", "label": "Shin Odds Conversion", "file_type": "concept", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2604.17194_Forecast_Sports_Outcomes_under_EMH_Odds_Only_Models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Infers outcome probabilities by modelling the proportion of insider bettors z present in the betting market."}, {"id": "2604_17194_power_conversion", "label": "Power Odds Conversion", "file_type": "concept", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2604.17194_Forecast_Sports_Outcomes_under_EMH_Odds_Only_Models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Raises inverse odds to a constant power exponent beta without an intercept term until implied probabilities sum to 1."}, {"id": "2604_17194_forecast_sports_outcomes_under_emh_odds_only_models_fl_glm", "label": "Favourite-Longshot Bias Adjusted GLM (FL-GLM)", "file_type": "concept", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2604.17194_Forecast_Sports_Outcomes_under_EMH_Odds_Only_Models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Proposed as a data-driven model to adjust for favourite-longshot bias using historical odds, outperforming standard multinomial and ordered logistic models under EMH."}, {"id": "2604_17194_forecast_sports_outcomes_under_emh_odds_only_models_oo_epc", "label": "Odds-Only Equal Profitability Confidence (OO-EPC)", "file_type": "concept", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2604.17194_Forecast_Sports_Outcomes_under_EMH_Odds_Only_Models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Proposed theoretically-driven odds-only method to ensure each outcome provides the bookmaker with identical confidence in profitability without needing historical odds data."}, {"id": "2604_17194_forecast_sports_outcomes_under_emh_odds_only_models_log_loss_metric", "label": "Log-Loss Proper Scoring Function", "file_type": "concept", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2604.17194_Forecast_Sports_Outcomes_under_EMH_Odds_Only_Models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Used to evaluate estimated probabilities because it is a proper scoring function minimised at true probabilities and directly captures bookmaker profitability via payout ratio."}, {"id": "2604_17194_forecast_sports_outcomes_under_emh_odds_only_models_shin_conversion", "label": "Shin Odds Conversion", "file_type": "concept", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2604.17194_Forecast_Sports_Outcomes_under_EMH_Odds_Only_Models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2604_17194_forecast_sports_outcomes_under_emh_odds_only_models_power_conversion", "label": "Power Conversion Method", "file_type": "concept", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2604.17194_Forecast_Sports_Outcomes_under_EMH_Odds_Only_Models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2604_17194_forecast_sports_outcomes_under_emh_odds_only_models_multiplicative_conversion", "label": "Multiplicative Conversion Method", "file_type": "concept", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2604.17194_Forecast_Sports_Outcomes_under_EMH_Odds_Only_Models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2604_17194_forecast_sports_outcomes_under_emh_odds_only_models_draw_bias", "label": "Draw Bias Phenomenon in Odds Conversion", "file_type": "concept", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2604.17194_Forecast_Sports_Outcomes_under_EMH_Odds_Only_Models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Observed tendency of bias-adjusting odds conversion methods and uniform FL-GLM to underestimate draw probability because draws exhibit weaker favourite-longshot bias than decisive outcomes."}], "edges": [{"source": "2604_17194_forecast_sports_outcomes_under_emh_odds_only_models_md", "target": "2604_17194_oo_epc_method", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2604.17194_Forecast_Sports_Outcomes_under_EMH_Odds_Only_Models.md", "source_location": null, "weight": 1.0}, {"source": "2604_17194_oo_epc_method", "target": "2604_17194_multiplicative_conversion", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2604.17194_Forecast_Sports_Outcomes_under_EMH_Odds_Only_Models.md", "source_location": null, "weight": 1.0}, {"source": "2604_17194_oo_epc_method", "target": "2604_17194_shin_conversion", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2604.17194_Forecast_Sports_Outcomes_under_EMH_Odds_Only_Models.md", "source_location": null, "weight": 1.0}, {"source": "2403_16282_1x2_odds_formulation", "target": "2604_17194_multiplicative_conversion", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.8, "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2604.17194_Forecast_Sports_Outcomes_under_EMH_Odds_Only_Models.md", "source_location": null, "weight": 1.0}, {"source": "2604_17194_forecast_sports_outcomes_under_emh_odds_only_models_fl_glm", "target": "2604_17194_forecast_sports_outcomes_under_emh_odds_only_models_draw_bias", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2604.17194_Forecast_Sports_Outcomes_under_EMH_Odds_Only_Models.md", "source_location": null, "weight": 1.0}, {