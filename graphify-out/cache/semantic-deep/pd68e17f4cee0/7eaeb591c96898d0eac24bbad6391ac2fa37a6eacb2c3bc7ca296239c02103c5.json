{"nodes": [{"id": "goto2026_study", "label": "Goto et al. (2026) Odds-Only and FL-GLM Conversion Study", "file_type": "paper", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2604.17194_Forecast_Sports_Outcomes_under_EMH_Odds_Only_Models.md", "source_location": "1-2", "source_url": "https://arxiv.org/abs/2604.17194", "captured_at": null, "author": "Kaito Goto, Naoya Takeishi, Takehisa Yairi", "contributor": null, "rationale": "Develops odds-to-probability conversion methods under the Efficient Market Hypothesis (OO-EPC and FL-GLM)."}, {"id": "goto2026_oo_epc", "label": "Odds-Only Equal Profitability Confidence (OO-EPC)", "file_type": "concept", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2604.17194_Forecast_Sports_Outcomes_under_EMH_Odds_Only_Models.md", "source_location": "1-2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Converts betting odds without historical fitting by aligning with bookmakers' equal-profitability-confidence pricing objective."}, {"id": "goto2026_fl_glm", "label": "Favourite-Longshot-Bias-Adjusted GLM (FL-GLM)", "file_type": "concept", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2604.17194_Forecast_Sports_Outcomes_under_EMH_Odds_Only_Models.md", "source_location": "1-2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single-parameter power-law GLM with adaptive intercept ensuring implied probabilities sum to 1 while capturing favourite-longshot bias."}, {"id": "concept_favourite_longshot_bias", "label": "Favourite-Longshot Bias (FLB)", "file_type": "concept", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2604.17194_Forecast_Sports_Outcomes_under_EMH_Odds_Only_Models.md", "source_location": "2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Empirical phenomenon where longshots are systematically overpriced and favourites are underpriced."}, {"id": "wenguerzhixin_xuexiziliao_2604_17194_oo_epc_method", "label": "Odds-Only Equal-Profitability-Confidence Method (OO-EPC)", "file_type": "concept", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2604.17194_Forecast_Sports_Outcomes_under_EMH_Odds_Only_Models.md", "source_location": null, "source_url": null, "captured_at": null, "author": "K. Goto", "contributor": null, "rationale": "Reduces all inverse odds by the same amount of standard errors to ensure bookmakers have equal confidence in profitability across outcomes, assuming independent bet volume is proportional to inverse odds."}, {"id": "wenguerzhixin_xuexiziliao_2604_17194_fl_glm_method", "label": "Favourite-Longshot-Bias-Adjusted GLM (FL-GLM)", "file_type": "concept", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2604.17194_Forecast_Sports_Outcomes_under_EMH_Odds_Only_Models.md", "source_location": null, "source_url": null, "captured_at": null, "author": "K. Goto", "contributor": null, "rationale": "Extends power law regression with an adaptive intercept normaliser and a single interpretable parameter beta measuring favourite-longshot bias, avoiding redundant relationship fitting under EMH."}, {"id": "wenguerzhixin_xuexiziliao_2604_17194_multiplicative_conversion", "label": "Multiplicative Odds Conversion", "file_type": "concept", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2604.17194_Forecast_Sports_Outcomes_under_EMH_Odds_Only_Models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "wenguerzhixin_xuexiziliao_2604_17194_numerical_shin_conversion", "label": "Numerical Variant of Shin Conversion", "file_type": "concept", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2604.17194_Forecast_Sports_Outcomes_under_EMH_Odds_Only_Models.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Erik Strumbelj", "contributor": null, "rationale": null}, {"id": "wenguerzhixin_xuexiziliao_2604_17194_analytical_shin_conversion", "label": "Analytical Variant of Shin Conversion", "file_type": "concept", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2604.17194_Forecast_Sports_Outcomes_under_EMH_Odds_Only_Models.md", "source_location": null, "source_url": null, "captured_at": null, "author": "M. Kizildemir et al.", "contributor": null, "rationale": null}, {"id": "wenguerzhixin_xuexiziliao_2604_17194_power_conversion", "label": "Power Conversion Method", "file_type": "concept", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2604.17194_Forecast_Sports_Outcomes_under_EMH_Odds_Only_Models.md", "source_location": null, "source_url": null, "captured_at": null, "author": "S. Clarke et al.", "contributor": null, "rationale": null}, {"id": "wenguerzhixin_xuexiziliao_2604_17194_draw_bias_finding", "label": "Draw Bias in Odds Conversion Models", "file_type": "concept", "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2604.17194_Forecast_Sports_Outcomes_under_EMH_Odds_Only_Models.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}], "edges": [{"source": "goto2026_study", "target": "goto2026_oo_epc", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2604.17194_Forecast_Sports_Outcomes_under_EMH_Odds_Only_Models.md", "source_location": "1-2", "weight": 1.0}, {"source": "goto2026_study", "target": "goto2026_fl_glm", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "\u6e29\u6545\u800c\u77e5\u65b0\u5b66\u4e60\u8d44\u6599/2604.17194_Forecast_Sports_Outcomes_under_EMH_Odds_Only_Models.md", "source_location": "1-2", "weight": 1.0}, {"source": "goto2026_fl_glm", "target": "concept